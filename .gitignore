# Build directories
build/
cmake-build-*/
out/

# CMake artifacts
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake
!CMakeLists.txt
compile_commands.json
CTestTestfile.cmake
Testing/

# Compiled objects and binaries
*.o
*.a
*.so
*.dylib
*.dll
*.exe

# Datasets and generated indexes (large binaries, never commit these)
data/*.hdf5
data/*.fbin
data/*.ibin
*.hnsw

# Benchmark output. The CSVs and the generated chart are small and are the
# evidence behind the README's numbers, so they are tracked; raster dumps are not.
results/*.png
!results/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
.DS_Store
*.swp
